{
  "name": "personal-finance",
  "private": true,
  "version": "0.0.5",
  "license": "MIT",
  "description": "Production-grade offline-first personal finance platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @personal-finance/mobile dev & pnpm --filter @personal-finance/api dev:dev",
    "dev:mobile": "pnpm --filter @personal-finance/mobile start",
    "dev:api": "pnpm --filter @personal-finance/api start:dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
