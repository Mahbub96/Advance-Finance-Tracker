# Application
NODE_ENV=development

# API
API_PORT=3000
API_HOST=0.0.0.0

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=personal_finance
DATABASE_URL=postgresql://finance:finance@localhost:5432/personal_finance?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth (replace in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# AI providers (optional — never required for core finance)
# AI_PROVIDER=
# OPENAI_API_KEY=
# NVIDIA_NIM_API_KEY=
