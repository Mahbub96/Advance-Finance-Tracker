  "devDependencies": {
    "@nestjs/testing": "^11.1.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
