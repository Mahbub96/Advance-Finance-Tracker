{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@personal-finance/types": ["../../packages/types/index.ts"],
      "@personal-finance/validation": ["../../packages/validation/index.ts"],
      "@personal-finance/api-client": ["../../packages/api-client/index.ts"],
      "@personal-finance/config": ["../../packages/config/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
