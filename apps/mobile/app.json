{
  "expo": {
    "name": "Personal Finance",
    "slug": "personal-finance",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "personalfinance",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.personalfinance.mobile"
    },
    "android": {
      "package": "app.personalfinance.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1F6FEB"
      }
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
